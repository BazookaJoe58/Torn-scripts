    /* ---- API sweep ------------------------------------------------------
     * Racing never calls the API. Only the selections that are actually
     * switched on get requested, and cooldowns+education share one call.
     * One sweep per hour is far inside Torn's 100 requests/minute limit.
     * ------------------------------------------------------------------ */
    function shouldPoll() {
      return Date.now() - PLATFORM.storage.get(SK.lastPoll, 0) >= CC.pollMs;
    }
    function poll(force) {
      const key = PLATFORM.apiKey();
      if (!key) { LOG.warn('poll skipped: no API key'); return Promise.resolve(); }
      if (!force && !shouldPoll()) { LOG.debug('poll skipped: not due yet'); return Promise.resolve(); }
      const selections = [];
      if (active.drug || active.booster || active.med) selections.push('cooldowns');
      if (active.edu) selections.push('education');
      const jobs = [];
      if (selections.length) {
        const url = 'https://api.torn.com/user/?selections=' + selections.join(',') +
                    '&key=' + encodeURIComponent(key);
        LOG.info('polling', UTIL.redact(url));
        jobs.push(PLATFORM.getJSON(url).then(handleUserData).catch(function (e) {
          LOG.error('cooldowns/education poll failed:', e.message);
          // Error 16 = key access level too low. Flag the features so the UI
          // stops advertising a level that does not actually work.
          if (/error 16/i.test(e.message)) {
            if (active.drug) REGISTRY.flagAccessTooLow('cd-drug');
            if (active.med) REGISTRY.flagAccessTooLow('cd-med');
            if (active.booster) REGISTRY.flagAccessTooLow('cd-booster');
            if (active.edu) REGISTRY.flagAccessTooLow('cd-edu');
