    DEBUG_PANELS.push({
      title: 'Cooldown alerts',
      buttons: [
        { label: 'Test drug',         run: function () { raise('drug', 'Test alert.'); } },
        { label: 'Test med',          run: function () { raise('med', 'Test alert.'); } },
        { label: 'Test booster',      run: function () { raise('booster', 'Test alert.'); } },
        { label: 'Test edu',          run: function () { raise('edu', 'Test alert.'); } },
        { label: 'Test OC',           run: function () { raise('oc', 'Test alert.'); } },
        { label: 'Test racing',       run: function () { raise('race', 'Test alert.'); } },
        { label: 'Force API poll',    run: function () { poll(true); } },
        { label: 'Dump status icons', copy: function () { return STATUS_ICONS.debugText(); } },
        { label: 'Dump racing state', copy: function () { return RACE.debugText(); } },
        { label: 'Dump travel state', copy: function () { return AWAY.debugText(); } },
        { label: 'Dump OC response',  copyAsync: function () { return dumpOcRaw(); } },
        { label: 'Clear snoozes',     run: function () { snoozeUntil = {}; saveSnooze(); } },
        { label: 'Re-arm one-shot alerts', run: function () {
            // Drug, med, booster and OC-ready each fire once and then latch, so
            // they do not repeat every second. The latch is saved, which means
            // an alert already fired stays quiet until the state resets. This
