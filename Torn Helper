    /* ---- lifecycle ---- */
    function startShared() {
      if (running) return;
      running = true;
      tickTimer = setInterval(function () { LOG.guard('cd.tick', tick); }, CC.tickMs);
      pollTimer = setInterval(function () { poll(false); }, CC.pollMs);
      raceTimer = setInterval(function () { LOG.guard('cd.scanIcons', scanIcons); }, CC.iconScanMs);
      // Status icons need a moment to render, especially on PDA.
      // The strip renders after Torn's own scripts run. A missing list now
      // reports as unknown rather than as "not in one", so an early scan is
      // harmless — it simply finds nothing and tries again on the next tick.
      setTimeout(function () { LOG.guard('cd.scanIcons.initial', scanIcons); }, 2000);
      document.addEventListener('visibilitychange', onVisible);
      // No poll here — activate() pools one for us. Firing another would just
      // duplicate it, since startShared runs as the first sub-feature comes up.
