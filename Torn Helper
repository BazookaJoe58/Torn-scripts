// ==UserScript==
// @name         Torn Helper
// @namespace    cam.torn.tools
// @version      0.7.6
// @description  All-in-one helper. Modular features with individual on/off toggles. Includes Cooldown Alerts (drug, booster, education, OC, racing). Works on Tampermonkey (PC) and Torn PDA (mobile).
// @author       Cam
// @updateURL    https://raw.githubusercontent.com/BazookaJoe58/Torn-scripts/refs/heads/main/Torn%20Helper
// @downloadURL  https://raw.githubusercontent.com/BazookaJoe58/Torn-scripts/refs/heads/main/Torn%20Helper
// @match        https://www.torn.com/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==
/* ============================================================================
 *
 *  TORN HELPER
 *
 *  CREDITS
 *    Cooldown Alerts is adapted from "Torn Cooldown & OC Sentinel" by
 *    BazookaJoe. The racing detection approach is adapted from
 *    "Torn City Race Alert" by Krimian.
 *
 *  FILE MAP  (search for "SECTION")
 *    SECTION 01  CONFIG ............ constants and tunables
 *    SECTION 02  LOG ............... logging + buffer + guard
 *    SECTION 03  PLATFORM .......... PC vs PDA, storage, http, api key
 *    SECTION 04  UTIL .............. shared helpers
 *    SECTION 05  SETTINGS .......... persisted on/off state
 *    SECTION 06  REGISTRY .......... feature lifecycle engine
 *    SECTION 07  FEATURE: COOLDOWN ALERTS
 *                07a  shared alert overlay + modal
 *                07b  (removed — status pill; cooldowns show as a live value
 *                      in the Features list now instead)
 *                07c  Torn's status icon strip (shared DOM reader)
 *                07d  racing detection (DOM only, no API)
 *                07e  cooldown core (API polling, timers, alerts)
 *                07f  feature registrations
 *    SECTION 08  FEATURE: MUGGING (hospital watchlist)
 *    SECTION 09  FEATURE: MARKET (highlight + mug figures)
 *    SECTION 10  FEATURE: TRAVEL (OC clash warning)
 *    SECTION 11  FEATURE: GYM (stat balancer)
 *    SECTION 12  FEATURE: PAGE INSPECTOR (developer)
 *    SECTION 12b FEATURE: GENERAL (to-do list)
 *    SECTION 13  FEATURE: placeholders
 *    SECTION 14  STYLES
 *    SECTION 15  UI
 *    SECTION 16  BOOT
 *
 *  CONSOLE
 *    TH.list()                  every feature and its state
 *    TH.enable('cd-race')       turn one on
 *    TH.cd.test('drug')         fire a test alert
 *    TH.cd.raceDebug()          dump every racing-ish element on the page
 *    TH.cd.poll()               force an API sweep now
 *    TH.report()                full debug report, ready to paste
 *
 * ========================================================================== */
(function () {
  'use strict';
  // Older Android WebViews ship NodeList without forEach. Cheap insurance:
  // this script iterates query results in a dozen places and every one of
  // them would throw without it.
  if (typeof NodeList !== 'undefined' && NodeList.prototype && !NodeList.prototype.forEach) {
    NodeList.prototype.forEach = Array.prototype.forEach;
  }
  /* ==========================================================================
   * SECTION 01 — CONFIG
   * ======================================================================== */
  const CONFIG = {
    scriptName: 'Torn Helper',
    scriptShort: 'TH',
    version: '0.7.6',
    logLevel: 'info',        // debug | info | warn | error | silent
    logBufferSize: 400,
    storageKeys: {
      settings: 'th.settings.v1',
      apiKey: 'th.apikey',
      todoItems: 'th.todo.items.v1'
    },
    ui: {
      mobileBreakpoint: 700,
      launcherLabel: 'TH',
      // Where the floating TH button sits: { side:'left'|'right', y:pixels }
      launcherPos: 'th.launcher.pos.v1',
      // How far a press must move before it counts as a drag instead of a tap.
      dragThresholdPx: 5,
      // How tall the main panel is on narrow screens (percent of viewport height).
      // Adjustable on the Settings tab — the default 80 is what it always was;
      // this exists because on some phones that is most of the screen.
      mobileHeightKey: 'th.ui.mobileheight.v1',
      mobileHeightDefault: 80,
      mobileHeightMin: 30,
      mobileHeightMax: 95,
      // Floating windows for features marked floatable:true (see REGISTRY).
      // Position is remembered per feature under floatPosPrefix + featureId.
      floatPosPrefix: 'th.float.pos.',
      floatDefaultWidth: 320,
      floatDefaultHeight: 420
    },
    maxFeatureErrors: 2,
    // ---- Developer access --------------------------------------------------
    // Hides the Debug tab until unlocked from the Settings tab. Note this is
    // convenience, not security: these credentials are in plaintext in this
    // file, so anyone who opens the script can read them. It keeps the tab out
    // of the way and prevents stray taps, nothing more.
    dev: {
      user: 'admin',
      pass: 'dr1f7n',
      unlockedKey: 'th.dev.unlocked.v1'   // stores a boolean only, never the password
    },
    // Torn's four preset key levels, lowest to highest. A feature declares the
    // lowest level that will work for it; the UI shows that everywhere it asks
    // for a key, so you never hand over more access than a feature needs.
    accessLevels: ['Public', 'Minimal', 'Limited', 'Full'],
    // ---- Page inspector tunables (developer tool) -------------------------
    inspector: {
      maxDepth: 5,            // how deep the structure dump walks
      maxNodes: 250,          // hard stop so a body dump cannot explode
      textPreview: 60,
      outerHtmlChars: 4000,   // 1200 kept cutting off the interesting part
      maxAttrChars: 40000,    // full attribute values, e.g. embedded page state
      maxBlobs: 12,
      maxBlobChars: 40000,
      minBlob: 40,            // ignore trivial values like {} or []
      maxNet: 80,
      netBodyChars: 400,
      maxChanges: 120,
      watchThrottleMs: 250,
      reportSoftLimit: 60000,
      reportHardLimit: 400000
    },
    // ---- Travel OC warning tunables ---------------------------------------
    travel: {
      bufferHours: 8,       // see the feature info for what this is really for
      ocCacheMs: 300000,    // OC data re-fetched at most every 5 minutes
      scanDebounceMs: 200
    },
    // ---- Item market tunables ---------------------------------------------
    market: {
      mvRefreshMs: 1800000,   // market values re-fetched at most every 30 min
      scanDebounceMs: 300,    // the market re-renders constantly; batch our work
      maxPerPass: 80,         // cap work per pass so scrolling stays smooth
      visibleOnly: true,      // only decorate what is on screen
      // Mug rate = base × (1 + merits + plunder), all additive. Confirmed
      // against the Torn wiki and forums. Base is an RNG 5–10% weighted toward
      // 5, so 5 is the realistic FLOOR — the figure shown is a worst case.
      // The mug lands on the after-tax amount, so tax is applied first.
      mug: { basePct: 5, meritsPct: 50, plunderPct: 36, taxPct: 5 },
      // Tier thresholds. Tier 6 is the gold flashing one.
      tiersDollar:  { t6: 200000, t5: 50000, t4: 40000, t3: 30000, t2: 20000, t1: 10000 },
      tiersPercent: { t6: 20, t5: 13, t4: 12, t3: 11, t2: 10, t1: 9 },
      storageKeys: { mv: 'th.mk.mv.v1', mvAt: 'th.mk.mvat.v1' }
    },
    // ---- Hospital watchlist tunables --------------------------------------
    watchlist: {
      spacingMs: 1500,          // minimum gap between any two player calls
      maxRetries: 4,            // retries when Torn rate-limits
      retryDelayMs: 4000,
      companyCacheMs: 86400000, // company type names cached for a day
      alertMin: 5,              // shout this many minutes before a release
      // Adaptive schedule. Each player is checked once when added, then again
      // as their timer approaches, rather than every player every minute.
      //
      // The next call is aimed at the largest checkpoint below their remaining
      // time, so it lands exactly on that mark. Inside finePhaseSec it just
      // polls every finePollSec until they are out.
      //
      // Worked example, 40 minutes in hospital:
      //   added        -> call now, 40 min left
      //   +20 min      -> call at 20 min left   (largest checkpoint under 40)
      //   +15 min      -> call at  5 min left
      //   then every minute: 4, 3, 2, 1, out.
      //   Six calls instead of forty.
      //
      // maxDelaySec stops a long stay sitting unchecked: an 6-hour hospital
      // trip gets an hourly ping until it drops under the top checkpoint.
      schedule: {
        checkpointsSec: [1200, 300],  // 20 min, 5 min
        finePhaseSec: 300,            // inside 5 minutes...
        finePollSec: 60,              // ...check every minute
        idleRecheckSec: 900,          // players not on any timer at all
        errorRetrySec: 120,           // after a failed call
        minDelaySec: 30,
        maxDelaySec: 3600
      },
      storageKeys: {
        ids: 'th.wl.ids.v1',
        companies: 'th.wl.companies.v1'
      }
    },
    // ---- Cooldown Alerts tunables -----------------------------------------
    cooldowns: {
      pollMs: 3600000,              // one API sweep per hour
      tickMs: 1000,                 // local countdown tick
      flashMs: 800,                 // overlay flash speed
      snoozeMs: 5 * 60000,          // "Snooze" button
      ackMs: 60 * 60000,            // "Acknowledge" button
      boosterThresholdS: 20 * 3600, // alert when booster drops below this
      remindOcMs: 30 * 60000,       // re-remind "not in an OC"
      remindEduMs: 30 * 60000,      // re-remind "no course active"
      remindRaceMs: 30 * 60000,     // re-remind "not in a race"
      iconScanMs: 5000,             // how often to read Torn's status icon strip
      bootstrapIfEmpty: true,       // poll immediately if no timers are known
      storageKeys: {
        ends: 'th.cd.ends.v1',
        snooze: 'th.cd.snooze.v1',
        state: 'th.cd.state.v1',
        lastPoll: 'th.cd.lastpoll.v1'
      }
    }
  };
  /* ==========================================================================
   * SECTION 01b — FAILURE VISIBILITY
   *
   * On PDA there is no console, so a boot failure is completely silent — the
   * script simply does not appear and there is nothing to read. This renders
   * any fatal error onto the page itself, with a copy button, using only the
   * most basic DOM calls so it cannot fail for the same reason.
   * ======================================================================== */
  const FATAL = (function () {
    let shown = false;
    function show(title, detail) {
      if (shown) return;
      shown = true;
      try {
        const box = document.createElement('div');
        box.setAttribute('style',
          'position:fixed;left:8px;right:8px;bottom:8px;z-index:2147483647;' +
          'background:#2a1416;color:#ffd7d7;border:2px solid #ff6b6b;border-radius:10px;' +
          'padding:12px;font:12px/1.45 monospace;max-height:60vh;overflow:auto;');
        const h = document.createElement('div');
        h.setAttribute('style', 'font-weight:700;color:#ff8f8f;margin-bottom:6px;');
        h.textContent = 'Torn Helper v' + CONFIG.version + ' — ' + title;
        box.appendChild(h);
        const pre = document.createElement('pre');
        pre.setAttribute('style', 'white-space:pre-wrap;margin:0 0 8px;');
        pre.textContent = detail;
        box.appendChild(pre);
        const copy = document.createElement('button');
        copy.setAttribute('style',
          'background:#ff6b6b;color:#2a1416;border:0;border-radius:6px;' +
          'padding:8px 12px;font-weight:700;margin-right:6px;');
        copy.textContent = 'Copy';
        copy.onclick = function () {
          const ta = document.createElement('textarea');
          ta.value = h.textContent + '\n\n' + detail;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); copy.textContent = 'Copied'; }
          catch (e) { copy.textContent = 'Select the text above'; }
          ta.remove();
        };
        box.appendChild(copy);
        const close = document.createElement('button');
        close.setAttribute('style',
          'background:transparent;color:#ffd7d7;border:1px solid #ff6b6b;' +
          'border-radius:6px;padding:8px 12px;');
        close.textContent = 'Dismiss';
        close.onclick = function () { box.remove(); };
        box.appendChild(close);
        (document.body || document.documentElement).appendChild(box);
      } catch (e) {
        // Absolute last resort.
        try { alert('Torn Helper failed: ' + title + '\n' + detail); } catch (e2) { /* give up */ }
      }
    }
    return { show: show };
  })();
  /* ==========================================================================
   * SECTION 02 — LOG
   * ======================================================================== */
  const LOG = (function () {
    const LEVELS = { debug: 10, info: 20, warn: 30, error: 40, silent: 99 };
    const buffer = [];
    function stringify(a) {
      if (typeof a === 'string') return a;
      if (a instanceof Error) return a.message;
      try { return JSON.stringify(a); } catch (e) { return String(a); }
    }
    function emit(level, fn, args) {
      buffer.push({
        t: new Date().toISOString().slice(11, 23),
        level: level,
        msg: args.map(stringify).join(' ')
      });
      if (buffer.length > CONFIG.logBufferSize) buffer.shift();
      if (LEVELS[level] >= LEVELS[CONFIG.logLevel]) {
        fn.apply(console, ['[' + CONFIG.scriptShort + ']'].concat(args));
      }
    }
    return {
      debug: function () { emit('debug', console.log, [].slice.call(arguments)); },
      info:  function () { emit('info',  console.log, [].slice.call(arguments)); },
      warn:  function () { emit('warn',  console.warn, [].slice.call(arguments)); },
      error: function () { emit('error', console.error, [].slice.call(arguments)); },
      // Returns { ok, value, error }. Never throws.
      guard: function (label, fn) {
        try { return { ok: true, value: fn(), error: null }; }
        catch (err) {
          emit('error', console.error, [label + ' threw:', err && err.message, '\n' + (err && err.stack)]);
          return { ok: false, value: null, error: err };
        }
      },
      lines: function () { return buffer.slice(); },
      dump: function () { console.table(buffer); return buffer.length + ' lines'; },
      clear: function () { buffer.length = 0; }
    };
  })();
  /* ==========================================================================
   * SECTION 03 — PLATFORM
   *
   * PDA replaces the literal ###PDA-APIKEY### in the source at runtime. The
   * placeholder is written ONCE; the comparison string is built by
   * concatenation so PDA cannot replace that copy too. Writing the
   * placeholder twice is the bug that makes detection always report "PDA".
   * ======================================================================== */
  const PLATFORM = (function () {
    const injectedKey = '###PDA-APIKEY###';
    const untouched = '###' + 'PDA-APIKEY' + '###';
    const keyWasReplaced = injectedKey !== untouched;
    const hasPdaHttp = typeof window.PDA_httpGet === 'function';
    const uaLooksPda = /TornPDA|Torn_PDA/i.test(navigator.userAgent || '');
    const isPDA = keyWasReplaced || hasPdaHttp || uaLooksPda;
    const hasGM = typeof GM_info !== 'undefined';
    const name = isPDA ? 'Torn PDA' : (hasGM ? 'Tampermonkey' : 'Plain browser');
    function get(key, fallback) {
      try {
        const raw = window.localStorage.getItem(key);
        return raw === null ? fallback : JSON.parse(raw);
      } catch (e) { LOG.warn('storage read failed:', key, e.message); return fallback; }
    }
    function set(key, value) {
      try { window.localStorage.setItem(key, JSON.stringify(value)); return true; }
      catch (e) { LOG.warn('storage write failed:', key, e.message); return false; }
    }
    function remove(key) {
      try { window.localStorage.removeItem(key); return true; }
      catch (e) { LOG.warn('storage remove failed:', key, e.message); return false; }
    }
    // Every outbound call is timestamped so the panel can show a live
    // requests-per-minute figure. Torn's limit is 100/min across all your
    // keys, shared with every other script you run, so this is worth seeing.
    const callTimes = [];
    // Keep the URLs too, redacted, so "why is it making calls?" is a question
    // that can be answered by reading rather than by guessing.
    const callLog = [];
    function noteCall(url) {
      const now = Date.now();
      callTimes.push(now);
      while (callTimes.length && now - callTimes[0] > 60000) callTimes.shift();
      callLog.push({ t: new Date(now).toISOString().slice(11, 19), url: redactUrl(url) });
      if (callLog.length > 40) callLog.shift();
    }
    function redactUrl(url) {
      return String(url || '').replace(/([?&](key|apikey|api_key)=)[^&#]*/gi, '$1[REDACTED]');
    }
    function recentCalls() { return callLog.slice(); }
    function callsLastMinute() {
      const now = Date.now();
      while (callTimes.length && now - callTimes[0] > 60000) callTimes.shift();
      return callTimes.length;
    }
    // api.torn.com sends permissive CORS headers, so plain fetch works on PC
    // with @grant none. PDA needs its own bridge for cross-origin requests.
    function httpGet(url) {
      if (/api\.torn\.com/.test(url)) noteCall(url);
      if (isPDA && hasPdaHttp) {
        LOG.debug('httpGet via PDA_httpGet');
        return Promise.resolve(window.PDA_httpGet(url)).then(function (r) {
          if (typeof r === 'string') return r;
          if (r && typeof r.responseText === 'string') return r.responseText;
          return JSON.stringify(r);
        });
      }
      LOG.debug('httpGet via fetch');
      return fetch(url).then(function (r) { return r.text(); });
    }
    function getJSON(url) {
      return httpGet(url).then(function (txt) {
        const data = JSON.parse(txt);
        if (data && data.error) {
          throw new Error('Torn API error ' + data.error.code + ': ' + data.error.error);
        }
        return data;
      });
    }
    function apiKey() {
      if (keyWasReplaced) return injectedKey;
      return get(CONFIG.storageKeys.apiKey, '') || '';
    }
    function setApiKey(k) { return set(CONFIG.storageKeys.apiKey, k || ''); }
    function hasApiKey() { return !!apiKey(); }
    return {
      isPDA: isPDA, isPC: !isPDA, name: name,
      keyWasReplaced: keyWasReplaced, hasPdaHttp: hasPdaHttp, hasGM: hasGM,
      storage: { get: get, set: set, remove: remove },
      httpGet: httpGet, getJSON: getJSON,
      callsLastMinute: callsLastMinute,
      recentCalls: recentCalls,
      apiKey: apiKey, setApiKey: setApiKey, hasApiKey: hasApiKey
    };
  })();
  /* ==========================================================================
   * SECTION 04 — UTIL
   * ======================================================================== */
  const UTIL = {
    escapeHtml: function (s) {
      return String(s === undefined || s === null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    },
    redact: function (url) {
      return String(url || '').replace(/([?&](key|apikey|api_key)=)[^&#]*/gi, '$1[REDACTED]');
    },
    pageId: function () { return location.pathname + location.search + location.hash; },
    trimTo: function (str, n) {
      if (!str) return '';
      const s2 = String(str).replace(/\s+/g, ' ').trim();
      return s2.length > n ? s2.slice(0, n) + '…' : s2;
    },
    clock: function () { return new Date().toISOString().slice(11, 19); },
    pad2: function (n) { return String(n).padStart(2, '0'); },
    fmtHMS: function (sec) {
      if (!Number.isFinite(sec) || sec < 0) sec = 0;
      const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = Math.floor(sec % 60);
      return UTIL.pad2(h) + ':' + UTIL.pad2(m) + ':' + UTIL.pad2(s);
    },
    // PDA can run scripts before the DOM exists.
    ready: function (cb) {
      if (document.body) return cb();
      const iv = setInterval(function () {
        if (document.body) { clearInterval(iv); cb(); }
      }, 50);
      setTimeout(function () { clearInterval(iv); }, 15000);
    },
    waitFor: function (selector, cb, timeoutMs) {
      const found = document.querySelector(selector);
      if (found) { cb(found); return function () {}; }
      const obs = new MutationObserver(function () {
        const el = document.querySelector(selector);
        if (el) { obs.disconnect(); cb(el); }
      });
      obs.observe(document.body, { childList: true, subtree: true });
      const to = setTimeout(function () {
        obs.disconnect(); LOG.warn('waitFor timed out:', selector);
      }, timeoutMs || 15000);
      return function () { obs.disconnect(); clearTimeout(to); };
    },
    // Drag helper shared by the pill and anything else that needs it.
    makeDraggable: function (el, handle, onDrop) {
      let dragging = false, offX = 0, offY = 0;
      function pt(e) { return e.touches && e.touches[0] ? e.touches[0] : e; }
      function down(e) {
        // Let taps on a real control inside the handle (e.g. a close button
        // in a floating window's header) act normally instead of being
        // captured as the start of a drag — preventDefault below otherwise
        // suppresses the synthetic click a touchstart/touchend would fire,
        // which is why a button inside a draggable header stops responding
        // on touch devices (PDA) even though it still works with a mouse.
        if (e.target && e.target.closest &&
            e.target.closest('button, input, textarea, select, a')) return;
        dragging = true;
        const r = el.getBoundingClientRect(), p = pt(e);
        offX = p.clientX - r.left; offY = p.clientY - r.top;
        el.style.right = 'auto'; el.style.transform = 'none';
        e.preventDefault();
      }
      function move(e) {
        if (!dragging) return;
        const p = pt(e);
        el.style.left = Math.max(4, Math.min(window.innerWidth - el.offsetWidth - 4, p.clientX - offX)) + 'px';
        el.style.top  = Math.max(4, Math.min(window.innerHeight - el.offsetHeight - 4, p.clientY - offY)) + 'px';
      }
      function up() {
        if (!dragging) return;
        dragging = false;
        if (onDrop) onDrop({ x: parseInt(el.style.left || '0', 10), y: parseInt(el.style.top || '0', 10) });
      }
      handle.addEventListener('mousedown', down);
      handle.addEventListener('touchstart', down, { passive: false });
      window.addEventListener('mousemove', move);
      window.addEventListener('touchmove', move, { passive: false });
      window.addEventListener('mouseup', up);
      window.addEventListener('touchend', up);
      return function cleanup() {
        window.removeEventListener('mousemove', move);
        window.removeEventListener('touchmove', move);
        window.removeEventListener('mouseup', up);
        window.removeEventListener('touchend', up);
      };
    }
  };
  /* ==========================================================================
   * SECTION 05 — SETTINGS
   * ======================================================================== */
  const SETTINGS = (function () {
    let store = PLATFORM.storage.get(CONFIG.storageKeys.settings, {});
    return {
      isOn: function (id, defaultOn) {
        if (Object.prototype.hasOwnProperty.call(store, id)) return !!store[id];
        return !!defaultOn;
      },
      setOn: function (id, on) {
        store[id] = !!on;
        PLATFORM.storage.set(CONFIG.storageKeys.settings, store);
        LOG.debug('setting saved', id, '=', !!on);
      },
      // Arbitrary per-feature values (numbers, strings), stored in the same
      // place as the toggles under a composite key so they back up together.
      // Key format: featureId::settingKey
      getVal: function (featureId, key, fallback) {
        const k = featureId + '::' + key;
        return Object.prototype.hasOwnProperty.call(store, k) ? store[k] : fallback;
      },
      setVal: function (featureId, key, value) {
        store[featureId + '::' + key] = value;
        PLATFORM.storage.set(CONFIG.storageKeys.settings, store);
        LOG.info('setting saved', featureId + '::' + key, '=', value);
      },
      exportJson: function () { return JSON.stringify(store, null, 2); },
      importJson: function (txt) {
        const parsed = JSON.parse(txt);
        if (typeof parsed !== 'object' || parsed === null) throw new Error('not an object');
        store = parsed;
        PLATFORM.storage.set(CONFIG.storageKeys.settings, store);
        LOG.info('settings imported,', Object.keys(store).length, 'entries');
      },
      reset: function () {
        store = {};
        PLATFORM.storage.remove(CONFIG.storageKeys.settings);
        LOG.info('settings reset to defaults');
      }
    };
  })();
  /* ==========================================================================
   * SECTION 06 — REGISTRY
   * Feature lifecycle. Nothing here is feature-specific.
   * ======================================================================== */
  const REGISTRY = (function () {
    const features = [];
    const byId = {};
    const state = {};   // id -> { running, cleanup, errors, lastError }
    function register(def) {
      if (!def || !def.id) { LOG.error('feature missing id, skipped'); return; }
      if (byId[def.id]) { LOG.error('duplicate feature id:', def.id); return; }
      const f = {
        id: def.id,
        name: def.name || def.id,
        category: def.category || 'Other',
        info: def.info || 'No description yet.',
        match: def.match || null,
        defaultOn: !!def.defaultOn,
        needsApiKey: !!def.needsApiKey,
        // Lowest key level that works. One of CONFIG.accessLevels, or null if
        // the feature makes no API calls at all.
        apiAccess: def.apiAccess || null,
        // Exact selections used, so a custom key can be built for just these.
        apiSelections: def.apiSelections || [],
        // Set at runtime if Torn rejects the key as too low (error 16).
