  /* ==========================================================================
   * SECTION 09 — FEATURE: MARKET
   *
   * Adapted from "Torn Market Suite" by BazookaJoe, reduced to the two parts
   * actually wanted: the tile highlight and the mug/tax figures.
   *
   * VERIFIED MARKUP (captured 2026-08-23)
   *   Grid tile:
   *     <div class="itemTile___gJeSo">
   *       <img class="torn-item image___S3vQy" src="/images/items/206/large.png">
   *       ... <span>$845,088</span><span>(12,573)</span>
   *
   *   Listing rows:
   *     <li class="sellerListWrapper___g1_6E">
   *       <ul><li>… <div>$845,088</div><div>2 available</div> …</li>…
   *
   * Class hashes change between builds, so everything matches on the readable
   * prefix. Row prices are found by matching "$1,234" text rather than by
   * class, because every div in a row is hashed and unlabelled.
   *
   * NOT TOUCHED: bazaar-* elements (a third-party bazaar script) and tmf-* /
   * silmaril-* (Torn Market Filler). Those are other people's userscripts and
   * this must keep working with or without them.
   * ======================================================================== */
  const MARKET = (function () {
    const MC = CONFIG.market;
    const SK = MC.storageKeys;
    let mv = PLATFORM.storage.get(SK.mv, {});     // itemId -> market_value
    let mvAt = PLATFORM.storage.get(SK.mvAt, 0);
    let fetching = false;
    let highlightOn = false, mugOn = false;
    let observer = null, debounce = null;
    /* ---- market values --------------------------------------------------- */
    function mvStale() { return Date.now() - mvAt >= MC.mvRefreshMs; }
    function ensureMv(force) {
      if (fetching) return Promise.resolve();
      if (!force && !mvStale() && Object.keys(mv).length) return Promise.resolve();
      if (!PLATFORM.hasApiKey()) { LOG.warn('market: no API key, cannot load values'); return Promise.resolve(); }
      fetching = true;
      const url = 'https://api.torn.com/torn/?selections=items&key=' +
                  encodeURIComponent(PLATFORM.apiKey());
      LOG.info('market: fetching item values');
      return PLATFORM.getJSON(url).then(function (data) {
        const out = {};
        const items = data.items || {};
        Object.keys(items).forEach(function (id) {
          out[id] = items[id].market_value || 0;
        });
        mv = out;
        mvAt = Date.now();
        PLATFORM.storage.set(SK.mv, mv);
        PLATFORM.storage.set(SK.mvAt, mvAt);
        LOG.info('market: loaded', Object.keys(mv).length, 'item values');
        fetching = false;
        scan();
      }).catch(function (e) {
        fetching = false;
        LOG.error('market: value fetch failed:', e.message);
      });
    }
    /* ---- settings readers ------------------------------------------------- */
    function num(featureId, key, def) {
      const v = Number(SETTINGS.getVal(featureId, key, def));
      return isFinite(v) ? v : def;
    }
    function thresholds(kind) {
      const src = kind === 'd' ? MC.tiersDollar : MC.tiersPercent;
      return {
        t6: num('mkt-highlight', kind + '6', src.t6),
        t5: num('mkt-highlight', kind + '5', src.t5),
        t4: num('mkt-highlight', kind + '4', src.t4),
        t3: num('mkt-highlight', kind + '3', src.t3),
        t2: num('mkt-highlight', kind + '2', src.t2),
        t1: num('mkt-highlight', kind + '1', src.t1)
      };
    }
    // The mug rate as a fraction, e.g. 0.093 for 9.3%.
    function mugRate() {
      const base = num('mkt-mug', 'basePct', MC.mug.basePct);
      const merits = num('mkt-mug', 'meritsPct', MC.mug.meritsPct);
      const plunder = num('mkt-mug', 'plunderPct', MC.mug.plunderPct);
      return (base / 100) * (1 + merits / 100 + plunder / 100);
    }
    function taxRate() { return num('mkt-mug', 'taxPct', MC.mug.taxPct) / 100; }
    /* ---- helpers ---------------------------------------------------------- */
    const PRICE_RE = /\$([0-9,]+)/;
    function parsePrice(text) {
      const m = String(text || '').match(PRICE_RE);
      return m ? parseInt(m[1].replace(/,/g, ''), 10) : null;
    }
    // Item id lives in the image path: /images/items/206/large.png
    function itemIdFromImg(scope) {
      const img = scope.querySelector('img[src*="/images/items/"]');
      const m = img && img.getAttribute('src').match(/\/images\/items\/(\d+)\//);
      return m ? m[1] : null;
    }
    // In list view the item is in the URL hash instead.
    function itemIdFromHash() {
      const m = location.hash.match(/itemID=(\d+)/i);
      return m ? m[1] : null;
    }
    function onScreen(el) {
      const r = el.getBoundingClientRect();
      return r.bottom > -100 && r.top < (window.innerHeight + 100);
    }
    function showFigures() {
      return SETTINGS.getVal('mkt-highlight', 'showFigures', true) !== false;
    }
    // Tiles are small, so the cash figure is abbreviated rather than printed
    // in full — $1.2m reads at a glance where $1,234,567 does not.
    function short(n) {
      const a = Math.abs(n);
      if (a >= 1e9) return (n / 1e9).toFixed(2).replace(/\.?0+$/, '') + 'b';
      if (a >= 1e6) return (n / 1e6).toFixed(2).replace(/\.?0+$/, '') + 'm';
      if (a >= 1e3) return Math.round(n / 1e3) + 'k';
      return String(Math.round(n));
    }
    // Which tier a value falls into, 6 down to 0 (0 = below tier 1).
    function tierOf(value, thr) {
      if (value >= thr.t6) return 6;
      if (value >= thr.t5) return 5;
      if (value >= thr.t4) return 4;
      if (value >= thr.t3) return 3;
      if (value >= thr.t2) return 2;
      if (value >= thr.t1) return 1;
      return 0;
    }
    /* ---- grid tile highlight ---------------------------------------------
     * Both the dollar profit and the percentage profit are scored, and the
     * LOWER of the two tiers wins — so a big cash gap on a cheap item does
     * not light up gold on percentage alone, and vice versa.
     * ------------------------------------------------------------------ */
    function tierForTile(price, value) {
      const profit = value - price;
      if (profit <= 0) return 0;
      const dTier = tierOf(profit, thresholds('d'));
      const pTier = tierOf((profit / Math.max(value, 1)) * 100, thresholds('p'));
      return Math.min(dTier, pTier);
    }
    function decorateTiles() {
      const tiles = document.querySelectorAll('div[class*="itemTile"]');
      let done = 0;
      for (let i = 0; i < tiles.length; i++) {
        if (done >= MC.maxPerPass) break;
        const tile = tiles[i];
        if (MC.visibleOnly && !onScreen(tile)) continue;
        const id = itemIdFromImg(tile);
        const price = parsePrice(tile.textContent);
        const value = id ? mv[id] : null;
        let cover = tile.querySelector(':scope > .th-mk-cover');
        let tag = tile.querySelector(':scope > .th-mk-tag');
        const tier = (price && value) ? tierForTile(price, value) : 0;
        // No tier means no highlight, and the figures go with it — they only
        // ever appear on tiles that are actually worth looking at.
        if (!tier) {
          if (cover) cover.remove();
          if (tag) tag.remove();
          continue;
        }
        if (!cover) {
          cover = document.createElement('div');
          cover.className = 'th-mk-cover';
          tile.style.position = tile.style.position || 'relative';
          tile.prepend(cover);
        }
        const cls = 'th-mk-cover th-mk-t' + tier;
        if (cover.className !== cls) cover.className = cls;
        const profit = value - price;
        const pct = (profit / Math.max(value, 1)) * 100;
        cover.title = 'Market value $' + value.toLocaleString() +
                      ' · profit $' + profit.toLocaleString() +
                      ' (' + pct.toFixed(1) + '%)';
        if (showFigures()) {
          if (!tag) {
            tag = document.createElement('div');
            tag.className = 'th-mk-tag';
            tile.appendChild(tag);
          }
          const html = '<span class="th-mk-cash">+$' + short(profit) + '</span>' +
                       '<span class="th-mk-pct">' + pct.toFixed(0) + '%</span>';
          if (tag.innerHTML !== html) tag.innerHTML = html;
        } else if (tag) {
          tag.remove();
        }
        done++;
      }
      return done;
    }
    function clearTiles() {
      document.querySelectorAll('.th-mk-cover, .th-mk-tag').forEach(function (n) { n.remove(); });
    }
    /* ---- listing rows: mug and tax figures -------------------------------- */
    function decorateRows() {
      const wrappers = document.querySelectorAll('li[class*="sellerListWrapper"]');
      if (!wrappers.length) return 0;
      const rate = mugRate();
      const tax = taxRate();
      let done = 0;
      for (let w = 0; w < wrappers.length; w++) {
        const rows = wrappers[w].querySelectorAll(':scope > ul > li');
        for (let i = 0; i < rows.length; i++) {
          if (done >= MC.maxPerPass) return done;
          const row = rows[i];
          if (MC.visibleOnly && !onScreen(row)) continue;
          if (row.querySelector(':scope .th-mk-mug')) continue;   // already done
          // Every div in a row is hashed and unlabelled, so find the price by
          // its text instead. First child div that is only a price.
          let priceEl = null, price = null;
          const cells = row.querySelectorAll('div');
          for (let c = 0; c < cells.length; c++) {
            const t = (cells[c].textContent || '').trim();
            if (/^\$[0-9,]+$/.test(t)) { priceEl = cells[c]; price = parsePrice(t); break; }
          }
          if (!priceEl || !price) continue;
          // The tax comes out of the SELLER's end: they receive price minus
          // tax. You still paid the full price. So the mug is a percentage of
          // what they received, and your effective cost is the price less
          // whatever you take back — not the taxed figure reduced again,
          // which would count the tax against you twice.
          const sellerGets = Math.floor(price * (1 - tax));
          const mugBack = Math.floor(sellerGets * rate);
          const effective = price - mugBack;
          const box = document.createElement('div');
          box.className = 'th-mk-mug';
          box.innerHTML =
            '<span class="th-mk-tax" title="What the seller receives after ' +
            Math.round(tax * 100) + '% market tax">$' + sellerGets.toLocaleString() + '</span>' +
            '<span class="th-mk-mugv" title="Your effective cost after mugging back ' +
            (rate * 100).toFixed(1) + '% of what they received ($' +
            mugBack.toLocaleString() + '). Assumes your payment is all they are ' +
            'carrying — they may hold much more, or bank it before you hit.">$' +
            effective.toLocaleString() + '</span>';
          priceEl.appendChild(box);
          done++;
        }
      }
      return done;
    }
    function clearRows() {
      document.querySelectorAll('.th-mk-mug').forEach(function (n) { n.remove(); });
    }
    /* ---- scanning --------------------------------------------------------- */
    function scan() {
      LOG.guard('market.scan', function () {
        if (highlightOn) decorateTiles();
        if (mugOn) decorateRows();
      });
    }
    function scheduleScan() {
      clearTimeout(debounce);
      debounce = setTimeout(scan, MC.scanDebounceMs);
    }
    function startObserver() {
      if (observer) return;
      observer = new MutationObserver(function (muts) {
        // Ignore our own insertions or this loops forever.
        for (let i = 0; i < muts.length; i++) {
          const t = muts[i].target;
          if (t && t.closest && (t.closest('.th-root') || t.closest('.th-mk-mug'))) continue;
          scheduleScan();
          return;
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
      window.addEventListener('scroll', scheduleScan, { passive: true });
      LOG.debug('market observer started');
    }
    function stopObserver() {
      if (!highlightOn && !mugOn && observer) {
        observer.disconnect();
        observer = null;
        window.removeEventListener('scroll', scheduleScan);
        clearTimeout(debounce);
        LOG.debug('market observer stopped');
      }
    }
    /* ---- lifecycle -------------------------------------------------------- */
    function enableHighlight() {
      highlightOn = true;
      startObserver();
      ensureMv(false).then(scan);
      return function () { highlightOn = false; clearTiles(); stopObserver(); };
    }
    function enableMug() {
      mugOn = true;
      startObserver();
      scan();
      return function () { mugOn = false; clearRows(); stopObserver(); };
    }
    /* ---- settings panel for the tier thresholds --------------------------- */
    function thresholdPanel(host) {
      const d = thresholds('d'), p = thresholds('p');
      function col(kind, vals, label, step) {
        let h = '<div class="th-mk-col"><div class="th-mk-coltitle">' + label + '</div>';
        [6, 5, 4, 3, 2, 1].forEach(function (n) {
          h += '<div class="th-set">' +
               '<label>Tier ' + n + ' ≥</label>' +
               '<input class="th-setnum" type="number" step="' + step + '" ' +
               'data-mk="' + kind + n + '" value="' + vals['t' + n] + '">' +
               '</div>';
        });
        return h + '</div>';
      }
      host.innerHTML =
        '<div class="th-pad">' +
        '<div class="th-h4">Highlight thresholds</div>' +
        '<p class="th-p">A tile lights up when the profit against market value clears ' +
        'a tier. Both the cash and the percentage must clear it — the lower of the two ' +
        'tiers wins, so a big margin on a cheap item will not light up gold on ' +
        'percentage alone.</p>' +
        '<div class="th-mk-cols">' +
        col('d', d, 'Profit $', '1000') +
        col('p', p, 'Profit %', '0.5') +
        '</div>' +
        '<div class="th-h4">Tier colours</div>' +
        '<div class="th-mk-swatches">' +
        [1, 2, 3, 4, 5, 6].map(function (n) {
          return '<div><span class="th-mk-sw th-mk-t' + n + '"></span>' + n + '</div>';
        }).join('') +
        '</div>' +
        '<p class="th-p">Tier 6 flashes so it stands out from the greens.</p>' +
        '<div class="th-wl-opt">' +
        '<label for="th-mk-fig">Show profit figures on tiles</label>' +
        '<button class="th-sw' + (showFigures() ? ' on' : '') + '" id="th-mk-fig" ' +
        'role="switch" aria-checked="' + showFigures() + '"></button>' +
        '</div>' +
        '<p class="th-p">Cash and percentage in the corner of any tile that is ' +
        'highlighted. Hover a tile for the exact numbers.</p>' +
        '<div class="th-btns"><button class="th-btn" data-mkact="refresh">Refresh market values</button>' +
        '<button class="th-btn danger" data-mkact="reset">Reset thresholds</button></div>' +
        '<p class="th-p" id="th-mk-status"></p>' +
        '</div>';
      function status() {
        const el = host.querySelector('#th-mk-status');
        if (!el) return;
        const n = Object.keys(mv).length;
        el.textContent = n
          ? n.toLocaleString() + ' item values, updated ' + new Date(mvAt).toLocaleTimeString()
          : 'No market values loaded yet.';
      }
      status();
      host.querySelectorAll('[data-mk]').forEach(function (inp) {
        inp.addEventListener('change', function () {
          const v = Number(inp.value);
          if (!isFinite(v)) return;
          SETTINGS.setVal('mkt-highlight', inp.dataset.mk, v);
          scan();
        });
      });
      const fig = host.querySelector('#th-mk-fig');
      fig.addEventListener('click', function () {
        const next = !showFigures();
        SETTINGS.setVal('mkt-highlight', 'showFigures', next);
        fig.classList.toggle('on', next);
        fig.setAttribute('aria-checked', String(next));
        clearTiles();
        scan();
      });
      host.querySelector('[data-mkact="refresh"]').addEventListener('click', function () {
        ensureMv(true).then(status);
      });
      host.querySelector('[data-mkact="reset"]').addEventListener('click', function () {
        [6, 5, 4, 3, 2, 1].forEach(function (n) {
          SETTINGS.setVal('mkt-highlight', 'd' + n, MC.tiersDollar['t' + n]);
          SETTINGS.setVal('mkt-highlight', 'p' + n, MC.tiersPercent['t' + n]);
        });
        thresholdPanel(host);
        scan();
      });
    }
    return {
      enableHighlight: enableHighlight,
      enableMug: enableMug,
      thresholdPanel: thresholdPanel,
      mugRate: mugRate,
      refresh: function () { return ensureMv(true); },
      values: function () { return mv; }
    };
  })();
  REGISTRY.register({
    id: 'mkt-highlight',
    name: 'Profit highlight',
    category: 'Market',
    info: 'Shades each item tile by how far under market value it is listed, in six ' +
          'tiers, and prints the cash and percentage profit in the corner. Tiers 1 to 5 ' +
          'are increasing depths of green; tier 6 flashes gold. ' +
          'Thresholds for both cash and percentage are adjustable — open this feature ' +
          'to set them. Market values come from one API call cached for 30 minutes.',
    match: /ItemMarket|imarket\.php|bazaar\.php/i,
    defaultOn: false,
    needsApiKey: true,
    apiAccess: 'Public',
    apiSelections: ['items'],
    panel: MARKET.thresholdPanel,
    init: function () { return MARKET.enableHighlight(); }
  });
  REGISTRY.register({
    id: 'mkt-mug',
    name: 'Mug and tax figures',
    category: 'Market',
    info: 'Puts two figures under each listing price: what the seller receives after ' +
          'market tax, and your effective cost once you mug that back. The tax comes ' +
          'out of their end, not yours, so the mug is a share of what they received and ' +
          'your cost is the full price less that. It assumes your payment is all they ' +
          'are carrying — a mug takes a share of their whole wallet, so the real ' +
          'recovery can be far more or nothing at all. The mug rate is base × ' +
          '(1 + merits + plunder), all additive. Base is an RNG 5 to 10 percent ' +
          'weighted toward 5, so leaving base at 5 shows the worst case. Note a ' +
          '7-star clothing store cuts a mug by 75 percent, and mug protection decays ' +
          'over 12 hours after someone has been hit — the real take is often lower.',
    match: /ItemMarket|imarket\.php|bazaar\.php/i,
    defaultOn: false,
    needsApiKey: false,
    apiAccess: null,
    apiSelections: [],
    settings: [
      { key: 'basePct', label: 'Base mug', unit: '%', min: 1, max: 10, step: 0.5, def: 5 },
      { key: 'meritsPct', label: 'Masterful Looting', unit: '%', min: 0, max: 50, step: 5, def: 50 },
      { key: 'plunderPct', label: 'Plunder weapon', unit: '%', min: 0, max: 100, step: 1, def: 36 },
      { key: 'taxPct', label: 'Market tax', unit: '%', min: 0, max: 20, step: 0.5, def: 5 }
    ],
    liveValue: function () { return (MARKET.mugRate() * 100).toFixed(1) + '%'; },
    init: function () { return MARKET.enableMug(); }
  });
  /* ==========================================================================
   * SECTION 10 — FEATURE: TRAVEL
   *
   * Warns before you fly if the round trip would run past your OC.
   * Concept from "BJ's Torn Travel OC Warning" by BazookaJoe.
   *
   * VERIFIED MARKUP (captured 2026-08-23). Torn no longer ships a data-model
   * blob on #travel-root — that older approach silently returns undefined on
   * the current build. Instead, picking a destination renders:
   *
   *   <div class="destinationPanel___EXGk8" aria-live="polite">
   *     <span class="country___m4_Mv">Switzerland</span>
   *     <time datetime="1h 56m"><span>01:56</span></time>
   *     <button class="torn-btn btn-dark-bg"
   *             aria-label="Travel to Switzerland">Travel</button>
   *
   * The datetime attribute is machine readable and already reflects your
   * flight type and perks, so it beats any lookup table we could build.
   * The panel is aria-live, so it swaps in place as you pick destinations.
