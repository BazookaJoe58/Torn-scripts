    function copyText(text, btn, okLabel) {
      const restore = btn ? btn.textContent : '';
      const done = function () {
        if (btn) {
          btn.textContent = okLabel || 'Copied';
          setTimeout(function () { btn.textContent = restore; }, 1600);
        }
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(function (e) {
          LOG.warn('clipboard API blocked:', e.message);
          legacyCopy(text, done);
        });
      } else { legacyCopy(text, done); }
    }
    function legacyCopy(text, done) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { LOG.warn('execCommand failed:', e.message); }
      ta.remove();
      if (ok) done();
      else LOG.warn('copy blocked — the same text is in the console, copy it from there');
    }
