    function handleUserData(data) {
      // cooldowns
      if (data.cooldowns) {
        const drugS = data.cooldowns.drug || 0;
        const medS = data.cooldowns.medical || 0;
        const boosterS = data.cooldowns.booster || 0;
        setEnd('drug', drugS);
        setEnd('med', medS);
        setEnd('booster', boosterS);
        const prevMed = (st.medS === undefined) ? 1 : st.medS;
        if (active.med && medS === 0 && prevMed !== 0) {
          raise('med', 'Medical cooldown is now 0.');
        }
        st.medS = medS;
        const prevDrug = (st.drugS === undefined) ? 1 : st.drugS;
        if (active.drug && drugS === 0 && prevDrug !== 0) {
          raise('drug', 'Drug cooldown is now 0.');
        }
        const threshold = boosterThresholdSec();
        const prevBooster = (st.boosterS === undefined) ? threshold + 1 : st.boosterS;
        if (active.booster && boosterS > 0 && boosterS <= threshold && prevBooster > threshold) {
          raise('booster', 'Booster cooldown is under ' + Math.round(threshold / 3600) +
                           ' hours (' + UTIL.fmtHMS(boosterS) + ' left).');
        }
        st.drugS = drugS;
        st.boosterS = boosterS;
        LOG.debug('cooldowns: drug', drugS, 'med', medS, 'booster', boosterS);
      }
      // education
      if (data.education_timeleft !== undefined || data.education_current !== undefined) {
        const left = data.education_timeleft || 0;
        setEnd('edu', left);
        const wasActive = !!st.eduActive;
        const nowActive = (data.education_current || 0) > 0 || left > 0;
        if (active.edu && wasActive && left === 0) {
          raise('edu', 'Education course finished.');
          st.eduLastAlert = Date.now();
        }
        st.eduActive = nowActive;
        LOG.debug('education: left', left, 'active', nowActive);
      }
