        }
        case 'resetcfg':
          REGISTRY.stopAll();
          SETTINGS.reset();
          REGISTRY.startAll();
          render();
          break;
        case 'loglevel': {
          const order = ['debug', 'info', 'warn', 'error', 'silent'];
          CONFIG.logLevel = order[(order.indexOf(CONFIG.logLevel) + 1) % order.length];
          LOG.error('log level is now ' + CONFIG.logLevel);
          render();
          break;
        }
        case 'copylog': copyText(debugReport(), btn, 'Report copied'); break;
        case 'clearlog': LOG.clear(); render(); break;
      }
    }
    function debugAction(ref, btn) {
      const parts = ref.split(':');
      const p = DEBUG_PANELS[parseInt(parts[0], 10)];
      if (!p) return;
      const b = (p.buttons || [])[parseInt(parts[1], 10)];
      if (!b) return;
      if (b.copy) {
        const r = LOG.guard('debugButton.copy', b.copy);
        if (r.ok) { console.log(r.value); copyText(r.value, btn, 'Copied'); }
      } else if (b.copyAsync) {
        // Buttons that have to fetch something before they can hand back text.
        const label = btn.textContent;
        btn.textContent = 'Working…';
        Promise.resolve()
          .then(b.copyAsync)
          .then(function (text) {
            console.log(text);
            btn.textContent = label;
            copyText(text, btn, 'Copied');
          })
          .catch(function (e) {
            btn.textContent = label;
            LOG.error('debug fetch failed:', e && e.message);
          });
      } else if (b.run) {
        LOG.guard('debugButton.run', b.run);
        setTimeout(render, 150);
      }
    }
    /* ---- render ---- */
    function render() {
      // Debug can be hidden while it is the active tab (e.g. after locking).
      if (tab === 'debug' && !devUnlocked) tab = 'features';
      // A feature's own screen is reachable any time it has one, on or off —
      // so settings (like the market highlight thresholds) can be adjusted
      // before ever switching the feature on.
      if (tab.indexOf('feature:') === 0) {
        const f = REGISTRY.get(tab.slice(8));
        if (!f || !f.panel) tab = 'features';
      }
      renderRail();
      renderTabs();
      if (tab.indexOf('feature:') === 0) {
        LOG.guard('render.featurePanel', function () { renderFeaturePanel(REGISTRY.get(tab.slice(8))); });
      } else if (tab === 'features') {
        LOG.guard('render.features', renderFeatures);
      } else {
        const r = LOG.guard('render.' + tab, tab === 'settings' ? renderSettings : renderDebug);
        bodyEl.innerHTML = r.ok ? r.value : '<div class="th-empty">Render failed — see console.</div>';
      }
      [].slice.call(bodyEl.querySelectorAll('[data-act]')).forEach(function (b) {
        b.addEventListener('click', function () { action(b.dataset.act, b); });
      });
      [].slice.call(bodyEl.querySelectorAll('[data-dbg]')).forEach(function (b) {
        b.addEventListener('click', function () { debugAction(b.dataset.dbg, b); });
      });
      // Numeric feature settings. 'change' fires on blur or Enter.
      [].slice.call(bodyEl.querySelectorAll('[data-set]')).forEach(function (inp) {
        inp.addEventListener('change', function () {
          const parts = inp.dataset.set.split('|');
          const f = REGISTRY.get(parts[0]);
          if (!f) return;
          const spec = f.settings.filter(function (s) { return s.key === parts[1]; })[0];
          if (!spec) return;
          let v = Number(inp.value);
          if (!isFinite(v)) v = spec.def;
          if (spec.min !== undefined) v = Math.max(spec.min, v);
          if (spec.max !== undefined) v = Math.min(spec.max, v);
          SETTINGS.setVal(f.id, spec.key, v);
          inp.value = v;                       // reflect any clamping back
          if (spec.onChange) LOG.guard('setting.onChange', function () { spec.onChange(v); });
          render();
        });
      });
      // Mobile panel height (Settings tab). Not a per-feature setting, so it
      // is not covered by the [data-set] loop above.
      const mh = bodyEl.querySelector('#th-mobileh');
      if (mh) {
        mh.addEventListener('change', function () {
          let v = Number(mh.value);
          if (!isFinite(v)) v = CONFIG.ui.mobileHeightDefault;
          v = Math.max(CONFIG.ui.mobileHeightMin, Math.min(CONFIG.ui.mobileHeightMax, v));
          PLATFORM.storage.set(CONFIG.ui.mobileHeightKey, v);
          mh.value = v;
          applyMobileHeight();
          LOG.info('mobile panel height set to', v + '%');
        });
      }
    }
    return {
      init: function () {
        injectStyles();
        buildPanel();
        buildLauncher();
        applyMobileHeight();
        renderRail();
        setInterval(function () { tickLiveValues(); }, 1000);
        LOG.info('UI ready');
      },
      open: open,
      close: close,
      // Jump straight back into a feature's own screen, used by the inspector
      // after picking an element with the panel closed. Floatable features
      // reopen their floating window instead of the main panel.
      openFeature: function (id) {
        const f = REGISTRY.get(id);
        if (f && f.floatable) { openFloating(id); return; }
        tab = 'feature:' + id;
        open();
      },
      refresh: function () { if (panel && panel.style.display !== 'none') render(); else renderRail(); },
      debugReport: debugReport
    };
  })();
  /* ==========================================================================
   * SECTION 16 — BOOT
   * ======================================================================== */
  UTIL.ready(function () {
    const boot = LOG.guard('boot', function () {
      LOG.info(CONFIG.scriptName + ' v' + CONFIG.version + ' starting');
      LOG.info('platform:', PLATFORM.name,
               '| PDA key injected:', PLATFORM.keyWasReplaced,
               '| PDA_httpGet:', PLATFORM.hasPdaHttp,
               '| GM:', PLATFORM.hasGM);
      LOG.info('page:', UTIL.redact(UTIL.pageId()));
      LOG.info('features registered:', REGISTRY.all().length);
      UI.init();
      REGISTRY.startAll();
      UI.refresh();
      // Torn changes the hash without reloading in places. Only features whose
      // applicability actually changed get touched.
      let lastPage = UTIL.pageId();
      setInterval(function () {
        const now = UTIL.pageId();
        if (now !== lastPage) {
          lastPage = now;
          LOG.debug('page changed to', UTIL.redact(now));
          if (REGISTRY.reevaluate()) UI.refresh();
        }
      }, 1000);
      window.TH = {
        version: CONFIG.version,
        config: CONFIG,
        platform: PLATFORM,
        log: LOG,
        util: UTIL,
        settings: SETTINGS,
        registry: REGISTRY,
        cd: CD,
        market: MARKET,
        travel: TRAVEL,
        gym: GYM,
        inspect: INSPECT,
        watchlist: WATCHLIST,
        todo: TODO,
        race: RACE,
        away: AWAY,
        icons: STATUS_ICONS,
        list: function () { console.table(REGISTRY.table()); return REGISTRY.all().length + ' features'; },
        enable: function (id) { const r = REGISTRY.setEnabled(id, true); UI.refresh(); return r; },
        disable: function (id) { const r = REGISTRY.setEnabled(id, false); UI.refresh(); return r; },
        report: function () { const r = UI.debugReport(); console.log(r); return r; },
        refreshUI: UI.refresh,
        closeUI: UI.close,
        openFeature: UI.openFeature,
        open: UI.open
      };
      LOG.info('ready — window.TH available');
    });
    // A thrown boot is otherwise completely silent on mobile.
    if (!boot.ok) {
      FATAL.show('failed to start', String(boot.error && boot.error.stack || boot.error));
      return;
    }
    // And a boot that does not throw but still leaves no button is just as
    // silent, so check the button actually made it onto the page.
    setTimeout(function () {
      if (document.querySelector('.th-launch')) return;
      FATAL.show('started but drew nothing', [
        'The script ran without throwing, but no launcher button reached the page.',
        '',
        'platform: ' + PLATFORM.name,
        'PDA key injected: ' + PLATFORM.keyWasReplaced,
        'PDA_httpGet: ' + PLATFORM.hasPdaHttp,
        'GM present: ' + PLATFORM.hasGM,
        'page: ' + UTIL.redact(UTIL.pageId()),
        'features registered: ' + REGISTRY.all().length,
        'body present: ' + !!document.body,
        'head present: ' + !!document.head,
        'styles injected: ' + !!document.getElementById('th-styles'),
        '',
        'log:',
        LOG.lines().map(function (l) { return l.t + ' [' + l.level + '] ' + l.msg; }).join('\n')
      ].join('\n'));
    }, 6000);
  });
})();