   * the OC needs you back — so everything below doubles it.
   * ======================================================================== */
  const TRAVEL = (function () {
    const TC = CONFIG.travel;
    let ocReadyAt = 0;       // epoch seconds, 0 = not in an OC
    let ocDetail = '';
    let ocFetchedAt = 0;
    let ocFetching = false;
    // Anything else that will come due mid-flight. Seconds from the last fetch.
    let due = { drug: null, med: null, booster: null, edu: null };
    let dueFetchedAt = 0, dueFetching = false;
    let observer = null, debounce = null, running = false;
    /* ---- OC data ---------------------------------------------------------
     * Its own small fetch rather than borrowing the cooldown module's, so the
     * feature works whether or not the OC alert is switched on.
     * ------------------------------------------------------------------ */
    function ensureOc(force) {
      if (ocFetching) return Promise.resolve();
      if (!force && Date.now() - ocFetchedAt < TC.ocCacheMs) return Promise.resolve();
      if (!PLATFORM.hasApiKey()) return Promise.resolve();
      ocFetching = true;
      const url = 'https://api.torn.com/v2/user/?selections=organizedcrime&key=' +
                  encodeURIComponent(PLATFORM.apiKey());
      return PLATFORM.getJSON(url).then(function (v2) {
        const oc = v2.organizedCrime || v2.organizedcrime || v2.organized_crime;
        if (oc && oc.ready_at) {
          ocReadyAt = oc.ready_at;
          const slots = Array.isArray(oc.slots) ? oc.slots : [];
          const filled = slots.filter(function (x) { return x && x.user; }).length;
          ocDetail = (oc.name || 'OC') + (oc.status ? ' · ' + oc.status : '') +
                     (slots.length ? ' · ' + filled + '/' + slots.length : '');
        } else {
          ocReadyAt = 0;
          ocDetail = '';
        }
        ocFetchedAt = Date.now();
        ocFetching = false;
        LOG.info('travel: OC ready_at', ocReadyAt || 'none');
        scan();
      }).catch(function (e) {
        ocFetching = false;
        LOG.error('travel: OC fetch failed:', e.message);
      });
    }
    // Cooldowns and education, so the warning can also say what will expire or
    // finish while you are in the air. One call, cached, same key.
    function ensureDue(force) {
      if (dueFetching) return Promise.resolve();
      if (!force && Date.now() - dueFetchedAt < TC.ocCacheMs) return Promise.resolve();
      if (!PLATFORM.hasApiKey()) return Promise.resolve();
      dueFetching = true;
      const url = 'https://api.torn.com/user/?selections=cooldowns,education&key=' +
                  encodeURIComponent(PLATFORM.apiKey());
      return PLATFORM.getJSON(url).then(function (d) {
        const cd = d.cooldowns || {};
        due = {
          drug: cd.drug || 0,
          med: cd.medical || 0,
          booster: cd.booster || 0,
          edu: d.education_timeleft || 0
        };
        dueFetchedAt = Date.now();
        dueFetching = false;
        LOG.debug('travel: cooldowns', JSON.stringify(due));
        scan();
      }).catch(function (e) {
        dueFetching = false;
        LOG.error('travel: cooldown fetch failed:', e.message);
      });
    }
    /* ---- reading the page ------------------------------------------------- */
    function panelEl() { return document.querySelector('[class*="destinationPanel"]'); }
    // "1h 56m" -> 116. Also copes with "45m" or "2h" alone, and falls back to
    // the visible "01:56" if the attribute is ever missing.
    function flightMinutes(panel) {
      const t = panel.querySelector('time');
      if (!t) return null;
      const dt = t.getAttribute('datetime') || '';
      const h = dt.match(/(\d+)\s*h/i);
      const m = dt.match(/(\d+)\s*m/i);
      if (h || m) {
        return (h ? parseInt(h[1], 10) * 60 : 0) + (m ? parseInt(m[1], 10) : 0);
      }
      const clock = (t.textContent || '').match(/(\d{1,2}):(\d{2})/);
      if (clock) return parseInt(clock[1], 10) * 60 + parseInt(clock[2], 10);
      LOG.warn('travel: could not read flight time from', dt || t.textContent);
      return null;
    }
    function destinationName(panel) {
      const c = panel.querySelector('[class*="country"]');
      if (c) return (c.textContent || '').trim();
      const btn = panel.querySelector('button[aria-label^="Travel to"]');
      if (btn) return btn.getAttribute('aria-label').replace(/^Travel to\s*/i, '');
      return 'there';
    }
    function bufferHours() {
      const v = Number(SETTINGS.getVal('trv-ocwarn', 'bufferH', TC.bufferHours));
      return (isFinite(v) && v >= 0) ? v : TC.bufferHours;
    }
    function fmtHM(mins) {
      const h = Math.floor(mins / 60), m = Math.round(mins % 60);
      return (h ? h + 'h ' : '') + m + 'm';
    }
    /* ---- the verdict ------------------------------------------------------ */
    function assess(oneWayMins) {
