        }));
      }
      if (active.oc) {
        const url2 = 'https://api.torn.com/v2/user/?selections=organizedcrime&key=' + encodeURIComponent(key);
        LOG.info('polling', UTIL.redact(url2));
        jobs.push(PLATFORM.getJSON(url2).then(handleOcData).catch(function (e) {
          LOG.error('OC poll failed:', e.message);
          if (/error 16/i.test(e.message)) REGISTRY.flagAccessTooLow('cd-oc');
          // A failed call tells us nothing about whether they are in an OC.
          // Setting false here is what produced false "not in an OC" alerts.
          st.ocInProgress = null;
          saveState();
        }));
      }
      if (!jobs.length) { LOG.debug('poll skipped: nothing active needs the API'); return Promise.resolve(); }
      return Promise.all(jobs).then(function () {
        PLATFORM.storage.set(SK.lastPoll, Date.now());
        saveEnds();
