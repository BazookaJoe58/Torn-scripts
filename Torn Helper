    /* ---- local tick: countdowns, finish edges, idle reminders ---- */
    function tick() {
      const values = {};
      if (active.drug) {
        const left = ends.drug ? secLeft(ends.drug) : 0;
        values.drug = UTIL.fmtHMS(Math.max(0, left));
        if (left <= 0 && st._drugZero !== true) {
          raise('drug', 'Drug cooldown is now 0.');
          st._drugZero = true;
        } else if (left > 0) {
          st._drugZero = false;
        }
      }
      if (active.med) {
        const left = ends.med ? secLeft(ends.med) : 0;
        values.med = UTIL.fmtHMS(Math.max(0, left));
        if (left <= 0 && st._medZero !== true) {
          raise('med', 'Medical cooldown is now 0.');
          st._medZero = true;
        } else if (left > 0) {
          st._medZero = false;
        }
      }
      if (active.booster) {
        const left = ends.booster ? secLeft(ends.booster) : 0;
        values.booster = UTIL.fmtHMS(Math.max(0, left));
        const threshold = boosterThresholdSec();
        if (left > 0 && left <= threshold) {
          if (!st._boosterLatched) {
            raise('booster', 'Booster cooldown is under ' + Math.round(threshold / 3600) +
                             ' hours (' + UTIL.fmtHMS(left) + ' left).');
            st._boosterLatched = true;
          }
        } else {
          st._boosterLatched = false;
        }
      }
      if (active.edu) {
        const left = ends.edu ? secLeft(ends.edu) : 0;
        values.edu = (ends.edu && left > 0) ? UTIL.fmtHMS(left) : 'idle';
        // Reminder runs off cached state rather than the hourly poll, so going
        // idle does not sit silent for up to an hour.
        if (st.eduActive === false &&
            Date.now() - (st.eduLastAlert || 0) >= remindMs('cd-edu', CC.remindEduMs)) {
          raise('edu', 'No education course is active.');
          st.eduLastAlert = Date.now();
          saveState();
        }
      }
      if (active.oc) {
        const left = ends.oc ? secLeft(ends.oc) : 0;
        values.oc = ends.oc ? (left > 0 ? UTIL.fmtHMS(left) : 'ready')
                  : (st.ocInProgress === false ? 'not in OC'
                  : st.ocInProgress === true ? 'in OC'
                  : '?');
        // The "ready" alert fires from handleOcData, which knows the crime id
        // and can fire once per crime. Repeating it here would double up.
        if (st.ocInProgress === false &&
            Date.now() - (st.ocLastAlert || 0) >= remindMs('cd-oc', CC.remindOcMs)) {
          raise('oc', 'You are not currently in an Organised Crime.');
          st.ocLastAlert = Date.now();
          saveState();
