    /* ---- organised crime -------------------------------------------------
     * Confirmed response shape (v2 user/?selections=organizedcrime):
     *
     *   { "organizedCrime": {
     *       "id": 2068586, "name": "Clinical Precision", "difficulty": 8,
     *       "status": "Recruiting",
     *       "created_at": ..., "planning_at": ..., "executed_at": null,
     *       "ready_at": 1787561262, "expired_at": 1787868391,
     *       "slots": [ { "position": "Imitator", "user": null, ... }, ... ],
     *       "rewards": null } }
     *
     *   ready_at    — when it can be executed. This is the countdown.
     *   executed_at — null until it actually runs.
     *   status      — "Recruiting" while slots are still being filled.
     *   slots[].user— null for an empty slot, so filled = slots with a user.
     *
     * The icon strip still decides WHETHER you are in one; this only supplies
     * the timer and the detail line.
     * ------------------------------------------------------------------ */
    function handleOcData(v2) {
      const domSays = STATUS_ICONS.has('Organized Crime:');
      let oc = undefined, foundKey = null;
      ['organizedCrime', 'organizedcrime', 'organized_crime'].forEach(function (k) {
        if (Object.prototype.hasOwnProperty.call(v2, k)) { oc = v2[k]; foundKey = k; }
      });
      if (foundKey === null) {
        st.ocInProgress = domSays;
        LOG.warn('OC: no recognised field. Top-level keys:', Object.keys(v2).join(', ') || '(none)');
        return;
      }
      if (!oc) {
        st.ocInProgress = (domSays === null) ? false : domSays;
        ends.oc = 0;
        st.ocDetail = '';
        LOG.debug('OC: field', foundKey, 'empty; icon says', domSays);
        return;
      }
      // Detail line for the pill tooltip and the debug panel.
      const slots = Array.isArray(oc.slots) ? oc.slots : [];
      const filled = slots.filter(function (s) { return s && s.user; }).length;
      st.ocDetail = (oc.name || 'Organised Crime') +
                    (oc.status ? ' · ' + oc.status : '') +
                    (slots.length ? ' · ' + filled + '/' + slots.length + ' slots' : '');
      const nowSec = Math.floor(Date.now() / 1000);
      const readyEpoch = oc.ready_at || 0;
      const left = readyEpoch ? Math.max(0, readyEpoch - nowSec) : 0;
      if (readyEpoch) setEnd('oc', left);
      else { ends.oc = 0; LOG.warn('OC: no ready_at in response'); }
      // "Ready" means executable, not finished — executed_at is still null.
      // Flagged per crime id so it alerts once, not on every tick afterwards.
      if (active.oc && readyEpoch && left === 0 && !oc.executed_at && st.ocReadyFlagged !== oc.id) {
        raise('oc', 'Organised Crime is ready to execute — ' + st.ocDetail);
        st.ocReadyFlagged = oc.id;
        st.ocLastAlert = Date.now();
      }
      if (left > 0) st.ocReadyFlagged = null;
      st.ocInProgress = (domSays === null) ? true : domSays;
      LOG.debug('OC:', st.ocDetail, '| ready in', left + 's', '| icon says', domSays);
    }
    // Raw response for diagnosing the above. The key is stripped from the URL.
    function dumpOcRaw() {
      const key = PLATFORM.apiKey();
      if (!key) return Promise.resolve('No API key saved, cannot fetch.');
      const url = 'https://api.torn.com/v2/user/?selections=organizedcrime&key=' +
                  encodeURIComponent(key);
      return PLATFORM.httpGet(url).then(function (txt) {
        let out = 'OC RAW RESPONSE\n' + UTIL.redact(url) + '\n\n';
        try {
          out += JSON.stringify(JSON.parse(txt), null, 2);
        } catch (e) {
          out += '(not valid JSON)\n' + txt;
        }
        if (out.length > 6000) out = out.slice(0, 6000) + '\n… [truncated]';
        return out;
      }).catch(function (e) {
        return 'OC request failed: ' + e.message;
      });
    }
    /* ---- status icon scan ------------------------------------------------
     * The icon strip is the authority on whether you are IN something. The API
     * is only the authority on HOW LONG is left. Splitting it that way removes
     * the guesswork that caused false "not in an OC" and "not in a race"
     * alerts, and costs nothing.
     * ------------------------------------------------------------------ */
    function scanIcons() {
      // racing — entirely DOM driven, no API involvement at all
      if (active.race) {
        const r = LOG.guard('race.check', RACE.check);
        if (r.ok) {
          raceInRace = r.value.inRace;
          raceReason = r.value.reason;
          // You cannot join a race from a plane or from abroad, so the
          // reminder is suppressed rather than nagging about something you
          // are unable to act on.
          const a = LOG.guard('away.check', AWAY.check);
          awayFromTorn = a.ok ? a.value.away : false;
          awayReason = a.ok ? a.value.reason : 'check failed';
          LOG.debug('race: inRace =', raceInRace, '|', raceReason,
                    '| away =', awayFromTorn);
          if (raceInRace === false && !awayFromTorn &&
              Date.now() - raceLastAlert >= remindMs('cd-race', CC.remindRaceMs)) {
            raise('race', 'You are not currently in a race.');
            raceLastAlert = Date.now();
          }
        }
      }
      // organised crime — presence of the icon settles it
      if (active.oc) {
        const inOc = STATUS_ICONS.has('Organized Crime:');   // Torn spells it -ized
        if (inOc !== null && st.ocInProgress !== inOc) {
          st.ocInProgress = inOc;
          if (!inOc) ends.oc = 0;
          LOG.info('OC state from status icon:', inOc ? 'in one' : 'not in one');
          saveState();
        }
      }
      // education — same idea
      if (active.edu) {
        const inCourse = STATUS_ICONS.has('Education:');
        if (inCourse !== null && st.eduActive !== inCourse) {
          st.eduActive = inCourse;
          if (!inCourse) ends.edu = 0;
          LOG.info('education state from status icon:', inCourse ? 'active' : 'idle');
          saveState();
        }
      }
