     * ------------------------------------------------------------------ */
    let lastBoosterThreshold = null;
    function boosterThresholdSec() {
      const hours = Number(SETTINGS.getVal('cd-booster', 'thresholdH', CC.boosterThresholdS / 3600));
      const safe = (isFinite(hours) && hours > 0) ? hours : (CC.boosterThresholdS / 3600);
      const sec = safe * 3600;
      // Moving the threshold has to clear the latch, otherwise raising it from
      // 20h to 30h would stay silent because it already fired once at 20h.
      if (lastBoosterThreshold !== null && lastBoosterThreshold !== sec) {
        st._boosterLatched = false;
        LOG.info('booster threshold changed to', safe, 'hours — alert re-armed');
      }
      lastBoosterThreshold = sec;
      return sec;
    }
    function remindMs(featureId, fallbackMs) {
      const mins = Number(SETTINGS.getVal(featureId, 'remindMin', fallbackMs / 60000));
      const safe = (isFinite(mins) && mins > 0) ? mins : (fallbackMs / 60000);
      return safe * 60000;
