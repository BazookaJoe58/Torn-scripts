   *   this browser only. Calls are spaced to stay well inside 100/minute.
   * ======================================================================== */
  const WATCHLIST = (function () {
    const WC = CONFIG.watchlist;
    const SK = WC.storageKeys;
    let ids = PLATFORM.storage.get(SK.ids, []);
    let records = {};           // id -> { name, state, until, companyTypeId, ... }
    let nextDue = {};           // id -> epoch ms of that player's next check
    let companyTypes = null;    // { "1": "Hair Salon", ... }
    let running = false, busy = false;
    let lastCallAt = 0;
    let pumpTimer = null;
    let statusLine = 'Not started.';
    let host = null;            // container element while the panel is open
    // Which releases have already been announced, keyed by id+until so the
    // same person is not announced twice for the same hospital stay.
    const announced = {};
    // The bazaar add button is a sub-option of this feature rather than its
    // own toggle, since it is useless without the watchlist running.
    let bazaarStop = null;
    function bazaarWanted() {
      return SETTINGS.getVal('mug-hospwatch', 'bazaarBtn', true) !== false;
    }
    function syncBazaarButton() {
      const want = running && bazaarWanted();
      // BAZAAR_ADD is declared further down the file. That is fine because
      // nothing calls this until boot, by which point every module exists —
      // but do not call syncBazaarButton at module-definition time.
      if (want && !bazaarStop) {
        bazaarStop = BAZAAR_ADD.start();
      } else if (!want && bazaarStop) {
        bazaarStop();
        bazaarStop = null;
      }
    }
    function saveIds() { PLATFORM.storage.set(SK.ids, ids); }
    /* ---- company type names ---------------------------------------------
     * Fetched once and cached for a day. Torn adds company types over time,
     * so a hardcoded list would silently show the wrong name.
     * ------------------------------------------------------------------ */
    function loadCompanyTypes() {
      const cached = PLATFORM.storage.get(SK.companies, null);
      if (cached && cached.map && (Date.now() - cached.t) < WC.companyCacheMs) {
        companyTypes = cached.map;
        LOG.debug('company types from cache:', Object.keys(companyTypes).length);
        return Promise.resolve();
      }
      const url = 'https://api.torn.com/torn/?selections=companies&key=' +
                  encodeURIComponent(PLATFORM.apiKey());
      LOG.info('fetching company type list');
      return PLATFORM.getJSON(url).then(function (data) {
        const src = data.companies || {};
        const map = {};
        Object.keys(src).forEach(function (k) {
          map[k] = (src[k] && src[k].name) ? src[k].name : ('Type ' + k);
        });
        companyTypes = map;
        PLATFORM.storage.set(SK.companies, { t: Date.now(), map: map });
        LOG.info('company types loaded:', Object.keys(map).length);
      }).catch(function (e) {
        LOG.error('company type list failed:', e.message);
        companyTypes = companyTypes || {};
      });
    }
    function companyLabel(rec) {
      if (!rec.companyTypeId) return 'Unemployed';
      if (companyTypes && companyTypes[rec.companyTypeId]) return companyTypes[rec.companyTypeId];
      return 'Type ' + rec.companyTypeId;
    }
    /* ---- travel direction ------------------------------------------------
     * Torn phrases the outbound leg as "Traveling to X" and the return leg as
     * "Returning to Torn from X". Anything that matches neither falls back to
     * the raw description rather than guessing a direction and being wrong.
     * ------------------------------------------------------------------ */
    function travelLabel(desc) {
      const d = String(desc || '').toLowerCase();
      if (d.indexOf('returning to torn') !== -1) return 'Travelling to Torn';
      if (d.indexOf('traveling to') !== -1 || d.indexOf('travelling to') !== -1) {
        return 'Travelling from Torn';
      }
      return desc || 'Travelling';
    }
    /* ---- fetching -------------------------------------------------------- */
    function fetchPlayer(id) {
      const url = 'https://api.torn.com/user/' + encodeURIComponent(id) +
                  '?selections=profile&key=' + encodeURIComponent(PLATFORM.apiKey());
      return PLATFORM.getJSON(url).then(function (d) {
        const s = d.status || {};
        const j = d.job || {};
        return {
          id: id,
          name: d.name || ('#' + id),
          state: s.state || 'Unknown',
          until: s.until || 0,
          description: s.description || '',
          companyTypeId: j.company_type || 0,
          companyName: j.company_name || '',
          position: j.position || '',
          checked: Date.now(),
          error: null
        };
      }).catch(function (e) {
        return { id: id, error: e.message || 'Request failed', checked: Date.now() };
      });
    }
    // Torn error 5 is "too many requests" — back off and try again rather than
    // dropping the player from this sweep.
    function fetchWithRetry(id, attempt) {
      attempt = attempt || 0;
      return fetchPlayer(id).then(function (r) {
        if (r.error && /error 5\b/.test(r.error) && attempt < WC.maxRetries) {
          records[id] = { id: id, error: 'Rate limited, retrying…' };
          paint();
          LOG.warn('rate limited on', id, '- retry', attempt + 1, 'of', WC.maxRetries);
          return new Promise(function (res) { setTimeout(res, WC.retryDelayMs); })
            .then(function () { return fetchWithRetry(id, attempt + 1); });
        }
        return r;
      });
    }
    /* ---- adaptive scheduling ---------------------------------------------
     * Each player carries their own next-check time. A pump runs once a second
     * and calls whichever player is furthest past due, one at a time with a
     * minimum gap, so the list can never burst against the rate limit.
     * ------------------------------------------------------------------ */
    function remainingSecFor(rec) {
      if (!rec || rec.error) return null;
      if ((rec.state === 'Hospital' || rec.state === 'Traveling') && rec.until) {
        return Math.max(0, rec.until - Math.floor(Date.now() / 1000));
      }
      return null;   // not on any timer
    }
    function nextDelaySec(rec) {
      const S = WC.schedule;
      if (rec && rec.error) return S.errorRetrySec;
      const remaining = remainingSecFor(rec);
      if (remaining === null) return S.idleRecheckSec;
      if (remaining <= 0) return S.minDelaySec;              // due out, confirm it
      if (remaining <= S.finePhaseSec) return S.finePollSec; // last stretch
      // Aim the next call at the largest checkpoint below the time remaining,
      // so it lands exactly on that mark rather than at an arbitrary interval.
      let target = 0;
      for (let i = 0; i < S.checkpointsSec.length; i++) {
        const c = S.checkpointsSec[i];
        if (c < remaining && c > target) target = c;
      }
      return Math.max(S.minDelaySec, Math.min(S.maxDelaySec, remaining - target));
    }
    function schedule(id, rec) {
      const d = nextDelaySec(rec);
      nextDue[id] = Date.now() + d * 1000;
      LOG.debug('watchlist', id, 'next check in', d + 's');
    }
    function dueNow(id) {
      return (nextDue[id] === undefined ? 0 : nextDue[id]) <= Date.now();
    }
    function idleStatus() {
      if (!ids.length) return 'No players on the list yet.';
      let soonest = null;
      ids.forEach(function (id) {
        const due = nextDue[id] === undefined ? 0 : nextDue[id];
        if (soonest === null || due < soonest) soonest = due;
      });
      const wait = Math.max(0, Math.round((soonest - Date.now()) / 1000));
      return ids.length + ' tracked · next check in ' + wait + 's';
    }
    // One call per pass at most.
    function pump() {
      if (!running || busy) return;
      if (!PLATFORM.hasApiKey()) { statusLine = 'No API key saved.'; paint(); return; }
      if (!ids.length) { statusLine = 'No players on the list yet.'; paint(); return; }
      if (Date.now() - lastCallAt < WC.spacingMs) return;
      // Whoever is furthest past due goes first.
      let pick = null, worst = -1;
      ids.forEach(function (id) {
        if (!dueNow(id)) return;
        const over = Date.now() - (nextDue[id] === undefined ? 0 : nextDue[id]);
        if (over > worst) { worst = over; pick = id; }
      });
      if (pick === null) { statusLine = idleStatus(); paint(); return; }
      busy = true;
      lastCallAt = Date.now();
      statusLine = 'Checking #' + pick + '…';
      paint();
      loadCompanyTypes()
        .then(function () { return fetchWithRetry(pick); })
        .then(function (r) {
          records[pick] = r;
          schedule(pick, r);
          busy = false;
          statusLine = idleStatus();
          paint();
        })
        .catch(function (e) {
          busy = false;
          nextDue[pick] = Date.now() + WC.schedule.errorRetrySec * 1000;
          LOG.error('watchlist check failed for', pick, '-', e.message);
          paint();
        });
    }
    // Manual button: make everything due, the pump drains it with spacing.
    function refreshAll() {
      ids.forEach(function (id) { nextDue[id] = 0; });
      LOG.info('watchlist manual refresh queued for', ids.length, 'players');
      statusLine = 'Refreshing…';
      paint();
    }
    /* ---- list management -------------------------------------------------- */
    function addId(raw) {
      const id = String(raw || '').trim();
      if (!/^\d+$/.test(id)) { statusLine = 'Player IDs are digits only.'; paint(); return; }
      if (ids.indexOf(id) !== -1) { statusLine = 'Already on the list.'; paint(); return; }
      ids.push(id);
      saveIds();
      nextDue[id] = 0;              // the pump picks it up on the next second
      statusLine = 'Added ' + id + ', looking it up…';
      paint();
      LOG.info('watchlist added', id, '- queued for immediate check');
    }
    function removeId(id) {
      ids = ids.filter(function (x) { return x !== id; });
      delete records[id];
      delete nextDue[id];
      saveIds();
      LOG.info('watchlist removed', id);
      paint();
    }
    /* ---- display ---------------------------------------------------------- */
    function fmtRemaining(ms) {
      if (ms <= 0) return '00:00:00';
      let total = Math.floor(ms / 1000);
      const days = Math.floor(total / 86400); total %= 86400;
      const h = Math.floor(total / 3600); total %= 3600;
      const m = Math.floor(total / 60);
      const s = total % 60;
      return (days > 0 ? days + 'd ' : '') + UTIL.pad2(h) + ':' + UTIL.pad2(m) + ':' + UTIL.pad2(s);
    }
    // Hospital first (soonest out at the top), then travellers by landing time,
    // then everyone else, errors last.
    function sortedRows() {
      return ids.map(function (id) {
        const r = records[id] || { id: id };
        return r;
      }).sort(function (a, b) {
        function rank(r) {
          if (r.error) return 4;
          if (r.state === 'Hospital' && r.until) return 0;
          if (r.state === 'Traveling' && r.until) return 1;
          return 2;
        }
        const ra = rank(a), rb = rank(b);
        if (ra !== rb) return ra - rb;
        if (ra <= 1) return (a.until || 0) - (b.until || 0);
        return 0;
      });
    }
    function stateCell(r) {
      if (r.state === 'Hospital' && r.until) {
        return '<span class="th-wl-timer th-wl-hosp" data-until="' + r.until + '">' +
               fmtRemaining(r.until * 1000 - Date.now()) + '</span>';
      }
      if (r.state === 'Traveling') {
        const label = travelLabel(r.description);
        const timer = r.until
          ? ' <span class="th-wl-timer" data-until="' + r.until + '">' +
            fmtRemaining(r.until * 1000 - Date.now()) + '</span>'
          : '';
        return '<span class="th-wl-travel">' + UTIL.escapeHtml(label) + '</span>' + timer;
      }
      return '<span class="th-wl-state">' + UTIL.escapeHtml(r.description || r.state || '—') + '</span>';
    }
    function paint() {
      if (!host || !host.isConnected) return;
      const st = host.querySelector('#th-wl-status');
      if (st) st.textContent = statusLine;
      const list = host.querySelector('#th-wl-list');
      if (!list) return;
      if (!ids.length) {
        list.innerHTML = '<div class="th-empty">Add a player ID above to start tracking.</div>';
        return;
      }
      list.innerHTML = sortedRows().map(function (r) {
        const link = 'https://www.torn.com/profiles.php?XID=' + encodeURIComponent(r.id);
        if (r.error) {
          return '<div class="th-wl-row">' +
                 '<div class="th-wl-main"><a class="th-wl-name" href="' + link + '" target="_blank">#' +
                 UTIL.escapeHtml(r.id) + '</a>' +
                 '<span class="th-wl-co th-wl-err">' + UTIL.escapeHtml(r.error) + '</span></div>' +
                 '<button class="th-wl-x" data-wlrm="' + UTIL.escapeHtml(r.id) + '">✕</button></div>';
        }
        const co = companyLabel(r);
        const coTitle = r.companyName
          ? (r.position ? r.position + ' at ' + r.companyName : r.companyName)
          : '';
        return '<div class="th-wl-row">' +
               '<div class="th-wl-main">' +
               '<a class="th-wl-name" href="' + link + '" target="_blank">' +
               UTIL.escapeHtml(r.name || ('#' + r.id)) + '</a>' +
               '<span class="th-wl-co" title="' + UTIL.escapeHtml(coTitle) + '">' +
               UTIL.escapeHtml(co) + '</span></div>' +
               stateCell(r) +
               '<button class="th-wl-x" data-wlrm="' + UTIL.escapeHtml(r.id) + '">✕</button></div>';
      }).join('');
      [].slice.call(list.querySelectorAll('[data-wlrm]')).forEach(function (b) {
        b.addEventListener('click', function () { removeId(b.dataset.wlrm); });
      });
    }
    // Fires once per hospital stay as a watched player nears release.
    function checkReleases() {
      const leadMin = Number(SETTINGS.getVal('mug-hospwatch', 'alertMin', WC.alertMin));
      const lead = (isFinite(leadMin) && leadMin > 0 ? leadMin : WC.alertMin) * 60;
      const now = Math.floor(Date.now() / 1000);
      ids.forEach(function (id) {
        const r = records[id];
        if (!r || r.error || r.state !== 'Hospital' || !r.until) return;
        const left = r.until - now;
        if (left > lead || left < -60) return;      // not yet, or long gone
        const tag = id + ':' + r.until;
        if (announced[tag]) return;
        announced[tag] = true;
        const who = r.name || ('#' + id);
        const mins = Math.max(0, Math.round(left / 60));
        LOG.info('watchlist release alert:', who, mins + 'm');
        ALERT_UI.show(
          'wl:' + id,
          'rgba(155,89,182,0.5)',
          'Out of hospital soon',
          who + ' is out in ' + (mins ? mins + ' min' : 'under a minute') +
            (r.companyTypeId ? ' · ' + companyLabel(r) : ''),
          { url: 'https://www.torn.com/profiles.php?XID=' + encodeURIComponent(id),
            label: 'Open ' + who },
          {
            featureId: 'mug-hospwatch',
            // Acknowledge and snooze just suppress this one person's release.
            onAck: function () { announced[tag] = true; },
            onSnooze: function () {
              announced[tag] = false;
              setTimeout(function () { announced[tag] = false; }, 5 * 60000);
            }
          }
        );
      });
    }
    // Countdowns tick in place so the whole list is not rebuilt every second.
    function tickTimers() {
      if (!host || !host.isConnected) return;
      const nodes = host.querySelectorAll('.th-wl-timer');
      for (let i = 0; i < nodes.length; i++) {
        const until = parseInt(nodes[i].dataset.until, 10) * 1000;
        nodes[i].textContent = fmtRemaining(until - Date.now());
      }
    }
    /* ---- the feature's own screen ---- */
    function renderPanel(container) {
      host = container;
      container.innerHTML =
        '<div class="th-pad">' +
        '<div class="th-h4">Hospital watchlist</div>' +
        '<p class="th-p" id="th-wl-status"></p>' +
        '<div class="th-btns" style="margin-bottom:10px">' +
        '<input class="th-search" id="th-wl-id" type="text" inputmode="numeric" ' +
        'placeholder="Player ID" style="flex:1;min-width:110px">' +
        '<button class="th-btn acc" data-wl="add">Add</button>' +
        '<button class="th-btn" data-wl="refresh">Refresh</button>' +
        '</div>' +
        '<div id="th-wl-list"></div>' +
        '<div class="th-h4">Options</div>' +
        '<div class="th-wl-opt">' +
        '<label for="th-wl-baz">Add button on player bazaars</label>' +
        '<button class="th-sw' + (bazaarWanted() ? ' on' : '') + '" id="th-wl-baz" ' +
        'role="switch" aria-checked="' + bazaarWanted() + '"></button>' +
        '</div>' +
        '<p class="th-p">Puts an add-to-watchlist button in the info message at the top ' +
        'of any player bazaar.</p>' +
        '</div>';
      const input = container.querySelector('#th-wl-id');
      container.querySelector('[data-wl="add"]').addEventListener('click', function () {
        addId(input.value);
        input.value = '';
      });
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { addId(input.value); input.value = ''; }
      });
      container.querySelector('[data-wl="refresh"]').addEventListener('click', function () {
        refreshAll();
      });
      const baz = container.querySelector('#th-wl-baz');
      baz.addEventListener('click', function () {
        const next = !bazaarWanted();
        SETTINGS.setVal('mug-hospwatch', 'bazaarBtn', next);
        baz.classList.toggle('on', next);
        baz.setAttribute('aria-checked', String(next));
        syncBazaarButton();
      });
      paint();
    }
    /* ---- lifecycle ---- */
    function start() {
      if (running) return;
      running = true;
      statusLine = 'Starting…';
      // Anything already on the list is due immediately on first start.
      ids.forEach(function (id) { if (nextDue[id] === undefined) nextDue[id] = 0; });
      // One timer drives both the countdown display and the call scheduler.
      pumpTimer = setInterval(function () {
        LOG.guard('watchlist.tick', tickTimers);
        LOG.guard('watchlist.releases', checkReleases);
        LOG.guard('watchlist.pump', pump);
      }, 1000);
      syncBazaarButton();
      LOG.info('watchlist started,', ids.length, 'players tracked');
    }
    function stop() {
      running = false;
      busy = false;
      clearInterval(pumpTimer); pumpTimer = null;
      host = null;
      statusLine = 'Stopped.';
      syncBazaarButton();
      LOG.info('watchlist stopped');
    }
    // Shown next to the feature name in the list.
    function summary() {
      if (!running) return null;
      let soonest = null;
      ids.forEach(function (id) {
        const r = records[id];
        if (r && r.state === 'Hospital' && r.until) {
          if (soonest === null || r.until < soonest) soonest = r.until;
        }
      });
      if (soonest !== null) return fmtRemaining(soonest * 1000 - Date.now());
      return ids.length ? ids.length + ' tracked' : 'empty';
    }
    return {
      start: start, stop: stop,
      renderPanel: renderPanel,
      summary: summary,
      refresh: refreshAll,
      ids: function () { return ids.slice(); },
      has: function (id) { return ids.indexOf(String(id)) !== -1; },
      add: addId,
      remove: removeId,
      isRunning: function () { return running; },
      records: function () { return records; }
    };
  })();
  REGISTRY.register({
    id: 'mug-hospwatch',
    name: 'Hospital watchlist',
    category: 'Mugging',
    info: 'Tracks player IDs you choose and sorts them by who leaves hospital soonest, ' +
          'with their company type and a live countdown. Travellers are shown as heading ' +
          'to or away from Torn, and it shouts when someone is close to release. Open ' +
          'this feature to manage the list, set the warning lead time, and turn the ' +
          'bazaar add button on or off. Advisory only, and calls are spaced to stay well ' +
          'inside the rate limit.',
    match: null,
    defaultOn: false,
    needsApiKey: true,
    apiAccess: 'Public',
    apiSelections: ['profile'],
    // Floats so it can stay open while you scroll other pages hunting
    // mugs/targets, instead of taking over the main panel.
    floatable: true,
    settings: [
      { key: 'alertMin', label: 'Alert before release', unit: 'minutes',
        min: 1, max: 60, step: 1, def: 5 }
    ],
    liveValue: function () { return WATCHLIST.summary(); },
    panel: WATCHLIST.renderPanel,
    init: function () {
      WATCHLIST.start();
      return function cleanup() { WATCHLIST.stop(); };
    }
  });
  /* ---- 08b — add to watchlist from a bazaar -------------------------------
   *
   * VERIFIED (captured 2026-08-23): a bazaar lives at
   *   bazaar.php?userId=2560768#/
   * with the page content under a plain, unhashed <div id="bazaarRoot">.
   *
   * The player id is right there in the query string, so no DOM parsing is
   * needed to identify whose bazaar this is — only somewhere to put a button.
   * ---------------------------------------------------------------------- */
  const BAZAAR_ADD = (function () {
    let barEl = null, timer = null;
    function playerId() {
      const m = location.search.match(/[?&]userId=(\d+)/i);
      return m ? m[1] : null;
    }
    // The info message carries a profile link with the owner's name in it:
    //   <a href="profiles.php?XID=2560768">Deadringers's</a>
    function playerName(id) {
      const a = document.querySelector('#bazaarRoot a[href*="profiles.php?XID=' + id + '"]');
      if (!a) return null;
      return (a.textContent || '').trim().replace(/'s$/, '');
    }
    // Sit inside Torn's own "…bazaar, favorited by… is currently open" message.
    // Those two classes are plain, not hashed, so they survive rebuilds. If the
    // message is not there, fall back to the top of the root.
    function anchor() {
      return document.querySelector('#bazaarRoot .msg.right-round') ||
             document.querySelector('#bazaarRoot [class*="messageContent"]') ||
             document.getElementById('bazaarRoot');
    }
    function render() {
      const id = playerId();
      if (!id) return;
      const host = anchor();
      if (!host) return;
      // Re-attach if the app re-rendered and threw our bar away.
      if (!barEl || !barEl.isConnected || !host.contains(barEl)) {
        if (barEl) barEl.remove();
        barEl = document.createElement('div');
        barEl.className = 'th-root th-bz-bar';
        barEl.style.position = 'static';
        if (host.id === 'bazaarRoot') host.prepend(barEl);
        else host.appendChild(barEl);
      }
      const onList = WATCHLIST.has(id);
      const name = playerName(id);
      const who = name ? UTIL.escapeHtml(name) + ' (#' + id + ')' : 'Player #' + id;
      barEl.innerHTML =
        '<span class="th-bz-id">' + who + '</span>' +
        '<button class="th-btn ' + (onList ? '' : 'acc') + '" data-bz="toggle">' +
        (onList ? 'On watchlist — remove' : 'Add to hospital watchlist') + '</button>' +
        (WATCHLIST.isRunning() ? '' :
          '<span class="th-bz-note">Hospital watchlist is switched off</span>');
      barEl.querySelector('[data-bz="toggle"]').addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (WATCHLIST.has(id)) WATCHLIST.remove(id);
        else WATCHLIST.add(id);
        render();
      });
    }
    function start() {
      // The bazaar is a hash-routed app, so its markup can be replaced under
      // us at any point. Cheap re-check rather than a broad observer.
      timer = setInterval(function () { LOG.guard('bazaar.render', render); }, 1000);
      LOG.guard('bazaar.render', render);
      LOG.info('bazaar add button active for player', playerId());
      return function cleanup() {
        clearInterval(timer); timer = null;
        if (barEl) { barEl.remove(); barEl = null; }
        LOG.info('bazaar add button stopped');
      };
    }
    return { start: start, debugText: function () {
      const id = playerId();
      return 'BAZAAR ADD BUTTON\n' +
             'player id from URL: ' + (id || 'NOT FOUND') + '\n' +
             '#bazaarRoot: ' + (document.getElementById('bazaarRoot') ? 'found' : 'MISSING') + '\n' +
             '.msg.right-round: ' + (document.querySelector('#bazaarRoot .msg.right-round') ? 'found' : 'missing') + '\n' +
             'anchor used: ' + (anchor() ? (anchor().className || anchor().id) : 'none') + '\n' +
             'bar attached: ' + (barEl && barEl.isConnected);
    } };
  })();
  DEBUG_PANELS.push({
    title: 'Bazaar add button',
    buttons: [
      { label: 'Dump bazaar state', copy: function () { return BAZAAR_ADD.debugText(); } }
    ]
